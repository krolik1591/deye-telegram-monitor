# Telegram — set STAGE=dev to use DEV_BOT_TOKEN, anything else uses PROD_BOT_TOKEN
STAGE=prod
DEV_BOT_TOKEN=
PROD_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# MongoDB
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/

# Tapo plugs (optional; bot must run on the plug's LAN; Tapo P110 only)
TAPO_USERNAME=
TAPO_PASSWORD=

# Deye bootstrap (optional; only read when `deye_personal` is empty)
# Telegram user_id allowed to control this device
USER_ID=
# Deye device serial number
DEVICE_SN=
# Deye app id
APP_ID=
# Deye app secret
APP_SECRET=
# Deye account email
EMAIL=
# Deye account password
# PASSWORD may be plaintext on first boot — bot hashes it and writes it back.
PASSWORD=
BATTERY_CAPACITY_KWH=
